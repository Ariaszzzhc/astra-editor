set(grammar_offline)
if(ASTRA_OFFLINE)
    if(WIN32)
        set(grammar_offline -Offline)
    else()
        set(grammar_offline --offline)
    endif()
endif()
if(WIN32)
    execute_process(COMMAND pwsh -NoProfile -File "${PROJECT_SOURCE_DIR}/scripts/prepare-grammars.ps1"
        ${grammar_offline} WORKING_DIRECTORY "${PROJECT_SOURCE_DIR}" COMMAND_ERROR_IS_FATAL ANY)
else()
    find_package(Python3 3.12 REQUIRED COMPONENTS Interpreter)
    execute_process(COMMAND "${Python3_EXECUTABLE}" "${PROJECT_SOURCE_DIR}/scripts/prepare-grammars.py"
        ${grammar_offline} WORKING_DIRECTORY "${PROJECT_SOURCE_DIR}" COMMAND_ERROR_IS_FATAL ANY)
endif()
file(READ "${PROJECT_SOURCE_DIR}/dependencies/grammars/manifest.json" grammar_manifest)
string(JSON package_count LENGTH "${grammar_manifest}" packages)
math(EXPR package_last "${package_count} - 1")
foreach(index RANGE ${package_last})
    string(JSON name GET "${grammar_manifest}" packages ${index} name)
    string(JSON directory GET "${grammar_manifest}" packages ${index} directory)
    set(grammar_${name} "${PROJECT_SOURCE_DIR}/.tools/grammars/${directory}")
endforeach()
function(astra_grammar name package source)
    set(directory "${grammar_${package}}/${source}")
    add_library(astra-grammar-${name} STATIC "${directory}/parser.c")
    target_include_directories(astra-grammar-${name} PRIVATE "${directory}")
    if(EXISTS "${directory}/scanner.c")
        target_sources(astra-grammar-${name} PRIVATE "${directory}/scanner.c")
    endif()
    set_target_properties(astra-grammar-${name} PROPERTIES C_STANDARD 11)
    if(MSVC)
        target_compile_options(astra-grammar-${name} PRIVATE /bigobj /w)
    endif()
endfunction()
astra_grammar(c c src)
astra_grammar(cpp cpp src)
astra_grammar(javascript javascript src)
astra_grammar(typescript typescript typescript/src)
astra_grammar(tsx typescript tsx/src)
astra_grammar(json json src)
astra_grammar(python python src)
astra_grammar(markdown markdown tree-sitter-markdown/src)
astra_grammar(markdown-inline markdown tree-sitter-markdown-inline/src)
