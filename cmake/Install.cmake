set(runtime_offline)
if(ASTRA_OFFLINE)
    if(WIN32)
        set(runtime_offline -Offline)
    else()
        set(runtime_offline --offline)
    endif()
endif()
if(WIN32)
    execute_process(COMMAND pwsh -NoProfile -File "${PROJECT_SOURCE_DIR}/scripts/prepare-windows-runtime.ps1"
        ${runtime_offline} WORKING_DIRECTORY "${PROJECT_SOURCE_DIR}" COMMAND_ERROR_IS_FATAL ANY)
    file(READ "${PROJECT_SOURCE_DIR}/.tools/runtime/windows-x64.json" pointer)
else()
    execute_process(COMMAND "${Python3_EXECUTABLE}" "${PROJECT_SOURCE_DIR}/scripts/prepare-native-runtime.py" ${runtime_offline}
        --cmake "${CMAKE_COMMAND}" --ninja "${CMAKE_MAKE_PROGRAM}"
        --dependency-prefix "${VCPKG_INSTALLED_DIR}/${VCPKG_TARGET_TRIPLET}"
        WORKING_DIRECTORY "${PROJECT_SOURCE_DIR}" COMMAND_ERROR_IS_FATAL ANY)
    if(APPLE)
        set(runtime_platform macosx)
    else()
        set(runtime_platform linux)
    endif()
    file(READ "${PROJECT_SOURCE_DIR}/.tools/runtime/${runtime_platform}-${VCPKG_TARGET_ARCHITECTURE}.json" pointer)
endif()
string(JSON runtime_directory GET "${pointer}" directory)
set(ASTRA_RUNTIME_DIRECTORY "${PROJECT_SOURCE_DIR}/${runtime_directory}")
set(ASTRA_CRT_STAGE_COMMAND)
if(MSVC)
    # Release distribution ships the toolchain's redistributable CRT locally.
    # Debug CRT staging is for development only; packaging requires Release.
    set(CMAKE_INSTALL_SYSTEM_RUNTIME_LIBS_SKIP TRUE)
    if(CMAKE_BUILD_TYPE STREQUAL "Debug")
        set(CMAKE_INSTALL_DEBUG_LIBRARIES TRUE)
    endif()
    include(InstallRequiredSystemLibraries)
    if(NOT CMAKE_INSTALL_SYSTEM_RUNTIME_LIBS)
        message(FATAL_ERROR "Visual C++ runtime libraries could not be located")
    endif()
    install(FILES ${CMAKE_INSTALL_SYSTEM_RUNTIME_LIBS} DESTINATION . COMPONENT Runtime)
    set(ASTRA_CRT_STAGE_COMMAND COMMAND "${CMAKE_COMMAND}" -E copy_if_different
        ${CMAKE_INSTALL_SYSTEM_RUNTIME_LIBS} "${CMAKE_RUNTIME_OUTPUT_DIRECTORY}")
endif()
set(ASTRA_DISTRIBUTION_TARGETS astra astra-server astra-clipboard-host)
if(WIN32)
    list(APPEND ASTRA_DISTRIBUTION_TARGETS astra-process-host)
endif()
add_custom_target(astra-production DEPENDS ${ASTRA_DISTRIBUTION_TARGETS})
install(TARGETS ${ASTRA_DISTRIBUTION_TARGETS} RUNTIME DESTINATION . COMPONENT Runtime)
if(WIN32)
    install(FILES "$<TARGET_FILE:SDL3::SDL3>" ${ASTRA_GRAPHICS_RUNTIME_FILES} DESTINATION . COMPONENT Runtime)
else()
    install(IMPORTED_RUNTIME_ARTIFACTS SDL3::SDL3 LIBRARY DESTINATION . COMPONENT Runtime)
endif()
install(DIRECTORY "${PROJECT_SOURCE_DIR}/resources" DESTINATION . COMPONENT Runtime)
foreach(directory IN ITEMS tools licenses provenance)
    install(DIRECTORY "${ASTRA_RUNTIME_DIRECTORY}/${directory}" DESTINATION . COMPONENT Runtime)
endforeach()
install(FILES "${ASTRA_RUNTIME_DIRECTORY}/THIRD-PARTY.md" "${ASTRA_RUNTIME_DIRECTORY}/runtime-manifest.json" DESTINATION . COMPONENT Runtime)
file(GLOB dependency_notices "${VCPKG_INSTALLED_DIR}/${VCPKG_TARGET_TRIPLET}/share/*/copyright")
foreach(notice IN LISTS dependency_notices)
    cmake_path(GET notice PARENT_PATH notice_directory)
    cmake_path(GET notice_directory FILENAME dependency_name)
    install(FILES "${notice}" DESTINATION "licenses/vcpkg/${dependency_name}" COMPONENT Runtime)
endforeach()
install(FILES "${VCPKG_INSTALLED_DIR}/vcpkg/status" DESTINATION provenance RENAME vcpkg-status.txt COMPONENT Runtime)
if(WIN32)
    install(FILES "${PROJECT_SOURCE_DIR}/packaging/README-WINDOWS.md" DESTINATION . RENAME README.md COMPONENT Runtime)
else()
    install(FILES "${PROJECT_SOURCE_DIR}/packaging/README-NATIVE.md" DESTINATION . RENAME README.md COMPONENT Runtime)
endif()
file(WRITE "${CMAKE_BINARY_DIR}/astra-version.txt" "${PROJECT_VERSION}\n")
file(SHA256 "${PROJECT_SOURCE_DIR}/dependencies/ports/skia/glyph-cache.patch" glyph_patch_hash)
set(astra_crt native)
if(MSVC)
    set(astra_crt MD)
    if(CMAKE_BUILD_TYPE STREQUAL "Debug")
        set(astra_crt MDd)
    endif()
endif()
file(WRITE "${CMAKE_BINARY_DIR}/build-provenance.json"
    "{\"generator\":\"${CMAKE_GENERATOR}\",\"configuration\":\"${CMAKE_BUILD_TYPE}\",\"triplet\":\"${VCPKG_TARGET_TRIPLET}\",\"crt\":\"${astra_crt}\",\"vcpkgStateSha256\":\"${ASTRA_VCPKG_STATE_SHA256}\",\"skiaGlyphPatchSha256\":\"${glyph_patch_hash}\"}\n")
install(FILES "${CMAKE_BINARY_DIR}/build-provenance.json" DESTINATION provenance COMPONENT Runtime)

# One shared developer runtime, never one copy per test executable.
add_custom_target(astra-runtime
    COMMAND "${CMAKE_COMMAND}" -E copy_directory "${PROJECT_SOURCE_DIR}/resources" "${CMAKE_RUNTIME_OUTPUT_DIRECTORY}/resources"
    COMMAND "${CMAKE_COMMAND}" -E copy_directory "${ASTRA_RUNTIME_DIRECTORY}/tools" "${CMAKE_RUNTIME_OUTPUT_DIRECTORY}/tools"
    COMMAND "${CMAKE_COMMAND}" -E copy_if_different "$<TARGET_FILE:SDL3::SDL3>" ${ASTRA_GRAPHICS_RUNTIME_FILES} "${CMAKE_RUNTIME_OUTPUT_DIRECTORY}"
    ${ASTRA_CRT_STAGE_COMMAND}
    COMMENT "Stage shared developer runtime")
add_dependencies(astra astra-runtime)
add_dependencies(astra-server astra-runtime)
add_dependencies(astra-clipboard-host astra-runtime)

set(CPACK_PACKAGE_NAME astra)
set(CPACK_PACKAGE_VERSION "${PROJECT_VERSION}")
if(WIN32)
    set(CPACK_GENERATOR ZIP)
else()
    set(CPACK_GENERATOR TGZ)
endif()
set(CPACK_PACKAGE_DIRECTORY "${PROJECT_SOURCE_DIR}/build/packages")
set(CPACK_PACKAGE_FILE_NAME "astra-${PROJECT_VERSION}-windows-x64")
set(CPACK_INCLUDE_TOPLEVEL_DIRECTORY ON)
if(CMAKE_BUILD_TYPE STREQUAL "Release")
    include(CPack)
endif()
