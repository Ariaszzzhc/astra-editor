 ShapedRun ShaperHarfBuzz::shape(char const * const utf8,
+                                  size_t const utf8Bytes,
+                                  char const * const utf8Start,
+                                  char const * const utf8End,
+                                  const BiDiRunIterator& bidi,
+                                  const LanguageRunIterator& language,
+                                  const ScriptRunIterator& script,
+                                  const FontRunIterator& font,
+                                  Feature const * const features, size_t const featuresSize,
+                                  float const textTracking) const
+{
+    if (!fRunCache) {
+        return shapeUncached(utf8, utf8Bytes, utf8Start, utf8End, bidi, language,
+                             script, font, features, featuresSize, textTracking);
+    }
+    using namespace SkShapers::HB;
+    CacheInput input{{utf8, utf8Bytes}, {size_t(utf8Start - utf8), size_t(utf8End - utf8Start)},
+                     font.currentFont(), bidi.currentLevel(), script.currentScript(),
+                     language.currentLanguage(), {features, featuresSize}, textTracking};
+    auto glyphs = fRunCache->shape(input, [&](RunHandler::Range range) {
+        SkASSERT(range.begin() >= input.range.begin() && range.end() <= input.range.end());
+        auto run = shapeUncached(utf8, utf8Bytes, utf8 + range.begin(), utf8 + range.end(),
+                                 bidi, language, script, font, features, featuresSize, textTracking);
+        RunCache::Glyphs result;
+        result.reserve(run.fNumGlyphs);
+        for (size_t i = 0; i < run.fNumGlyphs; ++i) {
+            const auto& glyph = run.fGlyphs[i];
+            result.push_back({glyph.fID, glyph.fCluster, glyph.fOffset, glyph.fAdvance,
+                              glyph.fHasVisual, glyph.fUnsafeToBreak, glyph.fUnsafeToConcat});
+        }
+        return result;
+    });
+    ShapedRun run(input.range, input.font, input.level, input.script, input.language,
+                  std::make_unique<ShapedGlyph[]>(glyphs.size()), glyphs.size());
+    for (size_t i = 0; i < glyphs.size(); ++i) {
+        const auto& glyph = glyphs[i];
+        auto& out = run.fGlyphs[i];
+        out.fID = glyph.id;
+        out.fCluster = glyph.cluster;
+        out.fOffset = glyph.offset;
+        out.fAdvance = glyph.advance;
+        out.fHasVisual = glyph.hasVisual;
+        out.fUnsafeToBreak = glyph.unsafeToBreak;
+        out.fUnsafeToConcat = glyph.unsafeToConcat;
+        out.fMustLineBreakBefore = false;
+        run.fAdvance += out.fAdvance;
+    }
+    return run;
+}
