{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 4,
    "minor": 4,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "windows-base",
      "hidden": true,
      "generator": "Ninja",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      },
      "environment": {
        "VCPKG_MAX_CONCURRENCY": "8"
      },
      "cacheVariables": {
        "CMAKE_TOOLCHAIN_FILE": "${sourceDir}/third_party/vcpkg/scripts/buildsystems/vcpkg.cmake",
        "CMAKE_MAKE_PROGRAM": "${sourceDir}/.tools/ninja/ninja.exe",
        "VCPKG_TARGET_TRIPLET": "x64-windows-astra",
        "VCPKG_HOST_TRIPLET": "x64-windows",
        "VCPKG_INSTALLED_DIR": "${sourceDir}/.tools/vcpkg/installed",
        "VCPKG_INSTALL_OPTIONS": "--x-buildtrees-root=${sourceDir}/.tools/vcpkg/buildtrees;--x-packages-root=${sourceDir}/.tools/vcpkg/packages",
        "CMAKE_MSVC_RUNTIME_LIBRARY": "MultiThreaded$<$<CONFIG:Debug>:Debug>DLL"
      }
    },
    {
      "name": "windows-debug",
      "binaryDir": "${sourceDir}/build/cmake/windows-debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "BUILD_TESTING": true,
        "VCPKG_MANIFEST_FEATURES": "tests"
      },
      "inherits": "windows-base"
    },
    {
      "name": "windows-release",
      "binaryDir": "${sourceDir}/build/cmake/windows-release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "BUILD_TESTING": true,
        "VCPKG_MANIFEST_FEATURES": "tests"
      },
      "inherits": "windows-base"
    },
    {
      "name": "windows-package",
      "binaryDir": "${sourceDir}/build/cmake/windows-package",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "BUILD_TESTING": false
      },
      "inherits": "windows-base"
    }
  ],
  "buildPresets": [
    {
      "name": "windows-debug",
      "configurePreset": "windows-debug",
      "jobs": 8
    },
    {
      "name": "windows-release",
      "configurePreset": "windows-release",
      "jobs": 8
    },
    {
      "name": "windows-package",
      "configurePreset": "windows-package",
      "jobs": 8
    }
  ],
  "testPresets": [
    {
      "name": "windows-debug",
      "configurePreset": "windows-debug",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "windows-release",
      "configurePreset": "windows-release",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
