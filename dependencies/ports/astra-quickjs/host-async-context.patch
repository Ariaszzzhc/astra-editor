diff --git a/quickjs.h b/quickjs.h
index 68d6f38..ada2967 100644
--- a/quickjs.h
+++ b/quickjs.h
@@ -1200,6 +1200,11 @@ typedef JSValue JSJobFunc(JSContext *ctx, int argc, JSValueConst *argv);
 JS_EXTERN int JS_EnqueueJob(JSContext *ctx, JSJobFunc *job_func,
                             int argc, JSValueConst *argv);
 
+/* Astra extension: a numeric host token is captured by jobs and promise
+   reactions and restored only while that continuation runs. No JS references
+   or host pointers are retained. Zero denotes work outside a host task. */
+JS_EXTERN uint64_t JS_GetHostAsyncContext(JSRuntime *rt);
+JS_EXTERN void JS_SetHostAsyncContext(JSRuntime *rt, uint64_t host_async_context);
 JS_EXTERN bool JS_IsJobPending(JSRuntime *rt);
 JS_EXTERN JSContext *JS_GetPendingJobContext(JSRuntime *rt);
 JS_EXTERN int JS_ExecutePendingJob(JSRuntime *rt, JSContext **pctx);
