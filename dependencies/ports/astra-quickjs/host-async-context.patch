+/* Astra's host token is captured when a continuation is registered. It is not
+   inferred from the task that later resolves the shared promise. */
+uint64_t JS_GetHostAsyncContext(JSRuntime *rt)
+{
+    return rt->host_async_context;
+}
+
+void JS_SetHostAsyncContext(JSRuntime *rt, uint64_t host_async_context)
+{
+    rt->host_async_context = host_async_context;
+}
+
+int JS_EnqueueJob(JSContext *ctx, JSJobFunc *job_func,
+                  int argc, JSValueConst *argv)
+{
+    return js_enqueue_job_with_context(ctx, job_func, argc, argv,
+                                       ctx->rt->host_async_context);
+}
