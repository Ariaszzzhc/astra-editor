* text=auto
*.cpp text eol=lf
*.hpp text eol=lf
*.lua text eol=lf
# Unified diffs retain their required space marker on empty context lines.
*.patch text eol=lf whitespace=-blank-at-eol
*.js text eol=lf
*.md text eol=lf
*.ps1 text eol=crlf
# Vendored artwork/notices and their hashed metadata stay byte-for-byte upstream.
resources/icons/** -text
dependencies/icons/licenses/** -text whitespace=-trailing-space
dependencies/icons/manifest.json text eol=lf
scripts/import-icons.mjs text eol=lf
